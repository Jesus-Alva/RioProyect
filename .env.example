# Origen permitido para la interfaz web durante el desarrollo local.
CORS_ORIGINS=http://localhost:3000

# Genera una clave privada con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=rio-claro-api
JWT_AUDIENCE=rio-claro-frontend
JWT_EXPIRE_MINUTES=30
AUTH_DATABASE_PATH=backend/users.db

# Endpoint del proyecto de Azure AI Foundry usado por el backend.
FOUNDRY_PROJECT_ENDPOINT=